<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Cade Eberhardt | Portfolio</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=DM+Sans:wght@300;400;500&display=swap');

    :root {
      --navy: #1b2a4a;
      --navy-dark: #111c30;
      --gold: #b8921a;
      --gold-light: #d4a832;
      --cream: #f9f8f6;
    }

    body { font-family: 'DM Sans', sans-serif; color: #2c2c2c; background: #fff; }

    /* NAVBAR */
    .navbar { background-color: var(--navy-dark) !important; }
    .navbar-brand {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.4rem;
      color: #fff !important;
      letter-spacing: 0.04em;
    }
    .nav-link { color: rgba(255,255,255,0.75) !important; font-size: 0.9rem; }
    .nav-link:hover { color: var(--gold-light) !important; }

    /* HERO */
    .hero {
      background: linear-gradient(135deg, var(--navy-dark) 0%, var(--navy) 100%);
      color: white;
      padding: 7rem 0 5rem;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      background: rgba(184,146,26,0.07);
      top: -100px;
      right: -100px;
    }

    .hero h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2.8rem, 6vw, 4.5rem);
      font-weight: 700;
      line-height: 1.1;
      margin-bottom: 0.5rem;
    }

    .hero .gold-text { color: var(--gold-light); }
    .hero .subtitle {
      font-size: 1.05rem;
      color: rgba(255,255,255,0.7);
      margin-bottom: 1.8rem;
      font-weight: 300;
      letter-spacing: 0.05em;
    }

    .hero-badges { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
    .hero-badge {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.18);
      color: rgba(255,255,255,0.85);
      padding: 0.3rem 0.85rem;
      border-radius: 2px;
      font-size: 0.82rem;
      letter-spacing: 0.05em;
    }

    .btn-gold {
      background-color: var(--gold);
      color: #fff;
      border: none;
      padding: 0.7rem 1.8rem;
      border-radius: 3px;
      font-size: 0.92rem;
      text-decoration: none;
      transition: background-color 0.2s;
    }
    .btn-gold:hover { background-color: var(--gold-light); color: #fff; }

    .btn-outline-gold {
      border: 1px solid rgba(255,255,255,0.35);
      color: rgba(255,255,255,0.85);
      padding: 0.7rem 1.8rem;
      border-radius: 3px;
      font-size: 0.92rem;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-outline-gold:hover { border-color: var(--gold-light); color: var(--gold-light); }

    /* STATS BAR */
    .stats-bar {
      background-color: var(--navy);
      color: white;
      padding: 1.5rem 0;
    }
    .stat-item { text-align: center; }
    .stat-number {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      color: var(--gold-light);
      font-weight: 700;
      display: block;
    }
    .stat-label { font-size: 0.78rem; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.08em; }

    /* SECTIONS */
    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      font-weight: 700;
      color: var(--navy);
      margin-bottom: 0.3rem;
    }
    .section-divider {
      width: 50px;
      height: 3px;
      background-color: var(--gold);
      margin-bottom: 2rem;
    }

    /* ABOUT */
    .about-section { padding: 5rem 0; background: var(--cream); }
    .about-icon-box {
      background: white;
      border-radius: 4px;
      padding: 1.5rem;
      text-align: center;
      border: 1px solid rgba(0,0,0,0.06);
      height: 100%;
    }
    .about-icon { font-size: 2rem; color: var(--gold); margin-bottom: 0.7rem; display: block; }
    .about-icon-box h5 { font-weight: 500; font-size: 0.95rem; color: var(--navy); margin-bottom: 0.4rem; }
    .about-icon-box p { font-size: 0.85rem; color: #777; margin: 0; }

    /* PAGES */
    .pages-section { padding: 5rem 0; }
    .page-card {
      border: 1px solid rgba(0,0,0,0.08);
      border-radius: 6px;
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s;
      height: 100%;
      text-decoration: none;
      color: inherit;
      display: block;
    }
    .page-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.1);
      color: inherit;
    }
    .page-card-header {
      padding: 2rem;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .page-card-icon {
      width: 52px;
      height: 52px;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      flex-shrink: 0;
    }
    .page-card h4 { font-weight: 500; font-size: 1.05rem; color: var(--navy); margin: 0 0 0.2rem; }
    .page-card p { font-size: 0.85rem; color: #888; margin: 0; }
    .page-card-body { padding: 0 2rem 1.5rem; font-size: 0.88rem; color: #555; line-height: 1.6; }
    .page-card-footer {
      padding: 1rem 2rem;
      border-top: 1px solid rgba(0,0,0,0.05);
      font-size: 0.82rem;
      color: var(--gold);
      font-weight: 500;
    }

    /* TIMELINE */
    .timeline-section { padding: 5rem 0; background: var(--cream); }
    .timeline-item { display: flex; gap: 1.5rem; margin-bottom: 2rem; }
    .timeline-dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background-color: var(--gold);
      flex-shrink: 0;
      margin-top: 5px;
    }
    .timeline-line { width: 2px; background: rgba(0,0,0,0.08); flex-shrink: 0; }
    .timeline-content h6 { font-weight: 500; color: var(--navy); margin-bottom: 0.2rem; }
    .timeline-content small { color: var(--gold); font-size: 0.8rem; display: block; margin-bottom: 0.3rem; }
    .timeline-content p { font-size: 0.88rem; color: #666; margin: 0; }

    /* FOOTER */
    footer {
      background-color: var(--navy-dark);
      color: rgba(255,255,255,0.5);
      padding: 2.5rem 0;
      text-align: center;
      font-size: 0.85rem;
    }
    footer a { color: var(--gold-light); text-decoration: none; }
  </style>
</head>
